{
  "schema_version": 1,
  "product": "wisent-visuals",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "pyproject.toml",
    "pattern": "(?m)^\\s*version\\s*=\\s*[\\\"'](?P<version>[0-9A-Za-z._-]+)[\\\"']"
  },
  "platforms": {
    "python": {
      "runner_platform": "linux-amd64",
      "quality": [],
      "build": {
        "argv": ["stado", "product", "python", "build"]
      },
      "stage": {
        "release/python-distributions.tar": "release/python-distributions.tar"
      }
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": [
    {
      "name": "pypi",
      "platform": "python",
      "argv": ["stado", "product", "python", "deliver-pypi"],
      "required": true,
      "secret_env": {
        "PYPI_TOKEN": "PYPI_TOKEN#token"
      }
    }
  ]
}
